# Copy to .env (gitignored). Testnet-only throwaway keys; never put a key that holds real funds here.
DEPLOYER_PRIVATE_KEY=0x...   # steward + oracle + relayer for the demo; needs testnet gas
INSPECTOR_PRIVATE_KEY=0x...  # demo inspector A; only signs EIP-712 typed data, never needs gas
INSPECTOR2_PRIVATE_KEY=0x... # demo inspector B, for a two-inspector certificate
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional, read by scripts/deploy.ts:
# STEWARD_ADDRESS=0x...
# ORACLE_ADDRESSES=0xA,0xB,0xC
# ORACLE_THRESHOLD=2
